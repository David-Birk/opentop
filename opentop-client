#!/usr/bin/env python3
"""opentop-client: zeigt den virtuellen Monitor eines opentop-host im Vollbild.

Meldet sich jede Sekunde per UDP-Broadcast, damit der Host den Monitor
automatisch anlegt. Gedacht für den Start in einer cage-Sitzung (Kiosk).
Ohne Verbindung zeigt er einen Wartebildschirm; Strg+Alt+Rücktaste beendet
ihn und damit die Sitzung, sodass SDDM wieder die Anmeldung anzeigt.
"""
import argparse
import glob
import json
import math
import os
import socket
import subprocess
import sys
import time

import cairo  # noqa: F401  (für Cairo-Kontexte in Gtk.DrawingArea)
import gi

gi.require_version("Gdk", "4.0")
gi.require_version("Gst", "1.0")
gi.require_version("GstRtp", "1.0")
gi.require_version("Gtk", "4.0")
from gi.repository import Gdk, GLib, Gst, GstRtp, Gtk

BEACON_PORT = 47800
STREAM_PORT = 47801
STALL_TIMEOUT = 3
QUIT_HINT = "Strg + Alt + Rücktaste  –  zurück zur Anmeldung"
CREDITS = "developed by David-Birk  ·  github.com/David-Birk"

CSS = b"""
window, .splash { background: #101318; color: #e6e9ef; }
.title { font-size: 64px; font-weight: 800; letter-spacing: 2px; }
.status { font-size: 22px; color: #9aa4b2; }
.address { font-size: 18px; color: #6c7686; font-family: monospace; }
.hint { font-size: 14px; color: #4f5866; }
.credits { font-size: 14px; color: #5f6a7a; }
"""


def log(*args):
    print("[opentop]", *args, flush=True)


def has_element(name):
    return Gst.ElementFactory.find(name) is not None


def screen_size():
    # Native Auflösung des ersten angeschlossenen Displays, damit der Host
    # passend skaliert statt 1080p auf ein kleines Panel zu schicken.
    for status in sorted(glob.glob("/sys/class/drm/card*-*/status")):
        try:
            with open(status) as f:
                if f.read().strip() != "connected":
                    continue
            with open(os.path.join(os.path.dirname(status), "modes")) as f:
                w, h = f.readline().strip().split("x")
            return [int(w), int(h)]
        except (OSError, ValueError):
            continue
    return None


def ipv4_addresses():
    try:
        out = subprocess.run(["ip", "-j", "-4", "addr", "show", "up"],
                             capture_output=True, text=True, check=True).stdout
    except (OSError, subprocess.CalledProcessError):
        return []
    return [a for iface in json.loads(out) if iface["ifname"] != "lo"
            for a in iface.get("addr_info", [])]


def broadcast_addresses():
    addrs = {a["broadcast"] for a in ipv4_addresses() if a.get("broadcast")}
    return sorted(addrs) or ["255.255.255.255"]


class Client:
    def __init__(self, args):
        self.args = args
        self.pipeline = None
        self.last_buffer = 0.0
        self.last_seq = None
        self.last_frame = 0.0
        self.stats = {"packets": 0, "lost": 0, "frames": 0}
        self.name = socket.gethostname()
        self.size = screen_size()
        self.sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        self.sock.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)

    def run(self):
        self.app = Gtk.Application(application_id="io.github.davidbirk.opentop")
        self.app.connect("activate", self.on_activate)
        self.app.run([])

    def on_activate(self, app):
        css = Gtk.CssProvider()
        css.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        self.window = Gtk.ApplicationWindow(application=app, title="opentop")
        self.window.set_cursor(Gdk.Cursor.new_from_name("none"))
        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self.on_key)
        self.window.add_controller(keys)

        self.picture = Gtk.Picture(content_fit=Gtk.ContentFit.CONTAIN)
        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
        self.stack.add_named(self.build_splash(), "splash")
        self.stack.add_named(self.picture, "video")
        self.window.set_child(self.stack)
        self.window.fullscreen()
        self.window.present()

        self.start_pipeline()
        self.send_beacon()
        self.update_splash()
        GLib.timeout_add_seconds(1, self.send_beacon)
        GLib.timeout_add_seconds(1, self.check_stall)
        GLib.timeout_add_seconds(5, self.log_stats)
        GLib.timeout_add_seconds(5, self.update_splash)
        GLib.timeout_add(500, self.check_picture)

    def build_splash(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18,
                      valign=Gtk.Align.CENTER, halign=Gtk.Align.CENTER)
        box.add_css_class("splash")
        title = Gtk.Label(label="opentop")
        title.add_css_class("title")
        row = Gtk.Box(spacing=14, halign=Gtk.Align.CENTER)
        row.append(self.build_spinner())
        self.status = Gtk.Label()
        self.status.add_css_class("status")
        row.append(self.status)
        self.address = Gtk.Label(justify=Gtk.Justification.CENTER)
        self.address.add_css_class("address")
        hint = Gtk.Label(label=QUIT_HINT, margin_top=40)
        hint.add_css_class("hint")
        for widget in (title, row, self.address, hint):
            box.append(widget)
        credits = Gtk.Label(label=CREDITS, valign=Gtk.Align.END, margin_bottom=28)
        credits.add_css_class("credits")
        outer = Gtk.Overlay(child=box)
        outer.add_css_class("splash")
        outer.add_overlay(credits)
        return outer

    def build_spinner(self):
        # Eigener Ladekreis statt Gtk.Spinner: dessen Animation kommt aus dem
        # GTK-Theme und steht bei manchen Themes (z.B. Breeze) still.
        area = Gtk.DrawingArea(content_width=30, content_height=30, valign=Gtk.Align.CENTER)
        area.set_draw_func(self.draw_spinner)
        GLib.timeout_add(33, lambda: area.get_mapped() and area.queue_draw() or True)
        return area

    def draw_spinner(self, _area, cr, width, height):
        radius = min(width, height) / 2 - 3
        cr.set_line_width(3.5)
        cr.set_source_rgb(0.16, 0.19, 0.25)
        cr.arc(width / 2, height / 2, radius, 0, 2 * math.pi)
        cr.stroke()
        angle = time.monotonic() * 2 * math.pi * 0.9
        cr.set_source_rgb(0.36, 0.55, 0.94)
        cr.arc(width / 2, height / 2, radius, angle, angle + math.pi * 0.6)
        cr.stroke()

    def update_splash(self):
        receiving = time.monotonic() - self.last_buffer < 1
        self.status.set_label("Verbinde …" if receiving else "Warte auf den Host …")
        ips = [a["local"] for a in ipv4_addresses()]
        self.address.set_label(f"{self.name}\n{'  ·  '.join(ips) or 'kein Netzwerk'}")
        return True

    def on_key(self, _ctrl, keyval, _keycode, state):
        mods = Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.ALT_MASK
        if keyval == Gdk.KEY_BackSpace and state & mods == mods:
            log("Beendet per Tastenkombination")
            self.pipeline.set_state(Gst.State.NULL)
            self.app.quit()
            return True
        return False

    def send_beacon(self, keyframe=False):
        # Über jedes Interface melden, damit der Host ein direktes Kabel
        # (Thunderbolt/USB) parallel zum WLAN sieht und bevorzugen kann.
        msg = json.dumps({"opentop": 1, "name": self.name, "size": self.size,
                          "keyframe": keyframe}).encode()
        for target in self.args.host or broadcast_addresses():
            try:
                self.sock.sendto(msg, (target, BEACON_PORT))
            except OSError as e:
                log(f"Beacon an {target} fehlgeschlagen:", e)
        return True

    def build_pipeline(self):
        dec = "vah264dec" if has_element("vah264dec") and not self.args.software else "avdec_h264"
        desc = (f"udpsrc name=src port={STREAM_PORT} buffer-size=4194304 "
                "caps=\"application/x-rtp,media=video,encoding-name=H264,payload=96,clock-rate=90000\" ! "
                # Im LAN kommen Pakete in Reihenfolge an; der Jitterbuffer kostet
                # dort nur Latenz und wird erst ab --latency > 0 eingebaut.
                + (f"rtpjitterbuffer name=jb latency={self.args.latency} drop-on-latency=true ! "
                   if self.args.latency else "") +
                f"rtph264depay name=depay ! h264parse ! {dec} ! identity name=shown ! "
                "gtk4paintablesink name=sink sync=false")
        log("Pipeline:", desc)
        pipeline = Gst.parse_launch(desc)
        pipeline.get_by_name("depay").get_static_pad("src").add_probe(
            Gst.PadProbeType.BUFFER, self.on_buffer)
        pipeline.get_by_name("src").get_static_pad("src").add_probe(
            Gst.PadProbeType.BUFFER, self.on_packet)
        pipeline.get_by_name("shown").get_static_pad("src").add_probe(
            Gst.PadProbeType.BUFFER, self.count, "frames")
        pipeline.get_bus().add_signal_watch()
        pipeline.get_bus().connect("message::error", self.on_error)
        self.picture.set_paintable(pipeline.get_by_name("sink").get_property("paintable"))
        return pipeline

    def on_packet(self, _pad, info):
        ok, rtp = GstRtp.RTPBuffer.map(info.get_buffer(), Gst.MapFlags.READ)
        if ok:
            seq = rtp.get_seq()
            rtp.unmap()
            if self.last_seq is not None and seq != (self.last_seq + 1) & 0xFFFF:
                self.stats["lost"] += (seq - self.last_seq - 1) & 0xFFFF
                GLib.idle_add(self.request_keyframe)
            self.last_seq = seq
        self.stats["packets"] += 1
        return Gst.PadProbeReturn.OK

    def count(self, _pad, _info, key):
        self.stats[key] += 1
        self.last_frame = time.monotonic()
        return Gst.PadProbeReturn.OK

    def request_keyframe(self):
        self.send_beacon(keyframe=True)
        return False

    def check_picture(self):
        # Pakete kommen, aber der Decoder zeigt nichts: er wartet auf einen
        # Keyframe (z.B. nach dem Start). Den sofort anfordern.
        now = time.monotonic()
        if now - self.last_buffer < 1 and now - self.last_frame > 1:
            self.request_keyframe()
        showing = now - self.last_frame < STALL_TIMEOUT
        page = "video" if showing else "splash"
        if self.stack.get_visible_child_name() != page:
            self.stack.set_visible_child_name(page)
            if not showing:
                self.update_splash()
        return True

    def log_stats(self):
        if self.stats["packets"]:
            log(f"Statistik 5s: {self.stats['packets']} Pakete, {self.stats['lost']} verloren, "
                f"{self.stats['frames']} Bilder angezeigt")
        self.stats = dict.fromkeys(self.stats, 0)
        return True

    def on_buffer(self, _pad, _info):
        self.last_buffer = time.monotonic()
        return Gst.PadProbeReturn.OK

    def start_pipeline(self):
        self.last_buffer = 0.0
        self.pipeline = self.build_pipeline()
        self.pipeline.set_state(Gst.State.PLAYING)

    def restart_pipeline(self):
        self.pipeline.set_state(Gst.State.NULL)
        self.start_pipeline()

    def check_stall(self):
        # Nach einem Host-Neustart Decoder/Jitterbuffer frisch aufsetzen.
        if self.last_buffer and time.monotonic() - self.last_buffer > STALL_TIMEOUT:
            log("Kein Bild mehr, warte auf Host ...")
            self.restart_pipeline()
        return True

    def on_error(self, _bus, msg):
        err, dbg = msg.parse_error()
        log("Fehler:", err.message, dbg)
        GLib.timeout_add_seconds(1, lambda: self.restart_pipeline() and False)


def main():
    p = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    p.add_argument("--host", action="append",
                   help="Host-IP direkt anschreiben statt Broadcast (mehrfach möglich, z.B. Tailscale)")
    p.add_argument("--latency", type=int, default=0,
                   help="Jitterbuffer in ms, z.B. 30 für WLAN (Standard: 0 = aus)")
    p.add_argument("--software", action="store_true", help="avdec_h264 statt VA-API verwenden")
    args = p.parse_args()

    Gst.init(None)
    try:
        Client(args).run()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    sys.exit(main())
