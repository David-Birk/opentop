#!/usr/bin/env python3
"""opentop-host: legt in KDE Plasma virtuelle Monitore an und streamt sie
verschlüsselt per H.264/SRTP an gekoppelte opentop-clients im LAN.

Clients melden sich per UDP-Broadcast. Ein neuer Client wird erst nach
Bestätigung eines 6-stelligen Codes gekoppelt. Für jeden gekoppelten Client,
der sich meldet, entsteht ein eigener virtueller Monitor; verschwindet er,
wird der Monitor wieder entfernt.
"""
import argparse
import ipaddress
import json
import os
import queue
import re
import socket
import subprocess
import sys
import threading
import time

sys.path[:0] = [os.path.dirname(os.path.realpath(__file__)),
                os.path.expanduser("~/.local/share/opentop")]
import opentop_proto as proto

import dbus
from dbus.mainloop.glib import DBusGMainLoop
import gi

gi.require_version("Gst", "1.0")
gi.require_version("GstVideo", "1.0")
from gi.repository import GLib, Gst, GstVideo

CLIENT_TIMEOUT = 6
REJECT_COOLDOWN = 300
PACING_BITRATE = 80_000_000
PACING_BURST = 16 * 1024
KEYFRAME_MIN_INTERVAL = 0.3
VIRTUAL_WIDTH = 1920  # KDE legt virtuelle Monitore fest mit 1920x1080 an
LINK_LOCAL = ipaddress.ip_network("169.254.0.0/16")
TOKEN_FILE = os.path.join(proto.CONFIG_DIR, "restore_token")
KEY_FILE = os.path.join(proto.CONFIG_DIR, "host.key")
CLIENTS_FILE = os.path.join(proto.CONFIG_DIR, "clients.json")

PORTAL_BUS = "org.freedesktop.portal.Desktop"
PORTAL_PATH = "/org/freedesktop/portal/desktop"
SOURCE_VIRTUAL = 4
CURSOR_EMBEDDED = 2
PERSIST_UNTIL_REVOKED = 2


def log(*args):
    print("[opentop]", *args, flush=True)


def notify(bus, summary, body=""):
    try:
        obj = bus.get_object("org.freedesktop.Notifications", "/org/freedesktop/Notifications")
        dbus.Interface(obj, "org.freedesktop.Notifications").Notify(
            "opentop", 0, "video-display", summary, body, [], {}, 3000)
    except dbus.DBusException:
        pass


class VirtualScreen:
    """ScreenCast-Portal-Sitzung mit einem virtuellen Monitor als Quelle."""

    def __init__(self, bus):
        self.bus = bus
        portal = bus.get_object(PORTAL_BUS, PORTAL_PATH)
        self.screencast = dbus.Interface(portal, "org.freedesktop.portal.ScreenCast")
        self.sender = bus.get_unique_name()[1:].replace(".", "_")
        self.counter = 0
        self.session = None

    def _call(self, method, *args, options, on_response):
        self.counter += 1
        token = f"opentop{os.getpid()}_{self.counter}"
        path = f"{PORTAL_PATH}/request/{self.sender}/{token}"

        def handler(code, results):
            match.remove()
            on_response(int(code), results)

        match = self.bus.add_signal_receiver(
            handler, "Response", "org.freedesktop.portal.Request", PORTAL_BUS, path)
        options["handle_token"] = token
        getattr(self.screencast, method)(*args, dbus.Dictionary(options, signature="sv"))

    def open(self, on_ready, on_error):
        def created(code, results):
            if code != 0:
                return on_error(f"CreateSession abgelehnt ({code})")
            self.session = str(results["session_handle"])
            options = {
                "types": dbus.UInt32(SOURCE_VIRTUAL),
                "cursor_mode": dbus.UInt32(CURSOR_EMBEDDED),
                "persist_mode": dbus.UInt32(PERSIST_UNTIL_REVOKED),
                "multiple": dbus.Boolean(False),
            }
            token = self._load_token()
            if token:
                options["restore_token"] = token
            self._call("SelectSources", self.session, options=options, on_response=selected)

        def selected(code, _results):
            if code != 0:
                return on_error(f"SelectSources abgelehnt ({code})")
            self._call("Start", self.session, "", options={}, on_response=started)

        def started(code, results):
            if code != 0:
                return on_error(f"Start abgelehnt ({code})")
            if "restore_token" in results:
                self._save_token(str(results["restore_token"]))
            node_id = int(results["streams"][0][0])
            fd = self.screencast.OpenPipeWireRemote(
                self.session, dbus.Dictionary({}, signature="sv")).take()
            on_ready(fd, node_id)

        self._call("CreateSession", options={"session_handle_token": f"opentop{os.getpid()}"},
                   on_response=created)

    def close(self):
        if not self.session:
            return
        try:
            obj = self.bus.get_object(PORTAL_BUS, self.session)
            dbus.Interface(obj, "org.freedesktop.portal.Session").Close()
        except dbus.DBusException as e:
            log("Session.Close fehlgeschlagen:", e)
        self.session = None

    @staticmethod
    def _load_token():
        try:
            with open(TOKEN_FILE) as f:
                return f.read().strip() or None
        except OSError:
            return None

    @staticmethod
    def _save_token(token):
        os.makedirs(proto.CONFIG_DIR, exist_ok=True)
        with open(TOKEN_FILE, "w") as f:
            f.write(token)


def has_element(name):
    return Gst.ElementFactory.find(name) is not None


class Pacer:
    """Verschickt RTP-Pakete gleichmäßig verteilt statt als Burst pro Bild.

    Ein Keyframe sind schnell über 100 Pakete; mit 1 Gbit/s am Stück
    rausgeschickt laufen die Puffer billiger Switches vor Clients mit
    100-Mbit-Anschluss über, und es fehlen Teile des Bildes.
    """

    def __init__(self, ip):
        self.ip = ip
        self.port = proto.STREAM_PORT
        self.queue = queue.Queue()
        self.sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        self.sock.setsockopt(socket.SOL_SOCKET, socket.SO_SNDBUF, 4 * 1024 * 1024)
        threading.Thread(target=self.run, daemon=True).start()

    def on_sample(self, sink):
        buf = sink.emit("pull-sample").get_buffer()
        self.queue.put(buf.extract_dup(0, buf.get_size()))
        return Gst.FlowReturn.OK

    def run(self):
        rate = PACING_BITRATE / 8
        tokens, last = PACING_BURST, time.perf_counter()
        while (data := self.queue.get()) is not None:
            now = time.perf_counter()
            tokens = min(PACING_BURST, tokens + (now - last) * rate)
            last = now
            if tokens < len(data):
                time.sleep((len(data) - tokens) / rate)
                tokens, last = len(data), time.perf_counter()
            tokens -= len(data)
            try:
                self.sock.sendto(data, (self.ip, self.port))
            except OSError:
                pass

    def close(self):
        self.queue.put(None)


def build_pipeline(fd, node_id, size, key, args):
    # path= nimmt die Node-ID (target-object erwartet die Serial). Ohne
    # dont-fallback weicht PipeWire sonst still auf die Webcam aus.
    src = (f"pipewiresrc name=src fd={fd} path={node_id} "
           "stream-properties=\"props,node.dont-fallback=true,node.dont-reconnect=true\" "
           f"do-timestamp=true keepalive-time=500 ! videorate drop-only=true max-rate={args.fps}")
    # Auf die Panel-Auflösung des Clients skalieren: spart Bandbreite und
    # nimmt schwachen Clients das Herunterskalieren ab.
    dims = f",width={size[0]},height={size[1]}" if size else ""
    if has_element("vah264enc") and not args.software:
        # KWin liefert DMABufs, die vapostproc nicht direkt importieren kann.
        enc = (f"video/x-raw ! videoconvertscale n-threads=4 ! video/x-raw,format=NV12{dims} ! "
               f"vah264enc bitrate={args.bitrate} key-int-max={args.fps} b-frames=0 "
               "rate-control=vbr target-usage=7")
    else:
        enc = (f"videoconvertscale n-threads=4 ! video/x-raw,format=I420{dims} ! "
               f"x264enc tune=zerolatency speed-preset=ultrafast bitrate={args.bitrate} "
               f"key-int-max={args.fps}")
    sink = (f"h264parse config-interval=-1 ! rtph264pay config-interval=-1 pt=96 mtu=1400 ! "
            f"srtpenc name=srtp {proto.SRTPENC_PARAMS} ! "
            "appsink name=out emit-signals=true sync=false async=false")
    desc = f"{src} ! {enc} ! {sink}"
    log("Pipeline:", desc)
    pipeline = Gst.parse_launch(desc)
    pipeline.get_by_name("srtp").set_property("key", Gst.Buffer.new_wrapped(proto.srtp_key(key)))
    return pipeline


def virtual_outputs():
    try:
        out = subprocess.run(["kscreen-doctor", "-j"], capture_output=True, text=True).stdout
        return {o["id"] for o in json.loads(out)["outputs"] if o["name"].startswith("Virtual")}
    except (OSError, ValueError, KeyError):
        return set()


def set_scale(output_id, client_width):
    # Logische Größe des virtuellen Monitors an das Client-Panel angleichen,
    # damit Schrift dort so groß ist wie auf einem nativen Display.
    scale = max(1.0, round(VIRTUAL_WIDTH / client_width * 20) / 20)
    log(f"Skalierung von Ausgabe {output_id} auf {scale:g}")
    subprocess.Popen(["kscreen-doctor", f"output.{output_id}.scale.{scale:g}"],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def is_direct_link(ip):
    # Kabelverbindungen (Thunderbolt/USB) laufen über IPv4-Link-Local.
    return ipaddress.ip_address(ip) in LINK_LOCAL


class Session:
    """Virtueller Monitor und Stream für genau einen gekoppelten Client."""

    def __init__(self, host, client_id, info):
        self.host = host
        self.id = client_id
        self.name = info["name"]
        self.key = proto.unb64(info["key"])
        self.screen = None
        self.pipeline = None
        self.pacer = None
        self.ip = None
        self.size = None
        self.peers = {}
        self.outputs_before = set()
        self.retry_at = 0.0
        self.backoff = 0
        self.last_keyframe = 0.0
        self.last_seq = 0
        self.frames = 0

    def on_beacon(self, msg, ip):
        if ip not in self.peers:
            log(f"{self.name} erreichbar über {ip}")
        self.peers[ip] = time.monotonic()
        if msg.get("keyframe") and ip == self.ip:
            self.request_keyframe()
        size = tuple(msg["size"]) if msg.get("size") else None
        if size != self.size:
            self.size = size
            if self.pipeline:
                log(f"{self.name}: Auflösung jetzt {size}, starte Stream neu")
                self.stop(quiet=True)
        self.update_target()

    def check_timeout(self):
        now = time.monotonic()
        for ip, seen in list(self.peers.items()):
            if now - seen > CLIENT_TIMEOUT:
                log(f"{self.name}: {ip} nicht mehr erreichbar")
                del self.peers[ip]
        self.update_target()

    def update_target(self):
        # Kabel vor WLAN; bei Gleichstand beim aktuellen Weg bleiben.
        best = max(self.peers, key=lambda ip: (is_direct_link(ip), ip == self.ip), default=None)
        if best is None:
            if self.ip:
                log(f"{self.name} weg, entferne virtuellen Monitor")
                self.stop()
        elif self.ip is None:
            # Nur eine Session gleichzeitig starten, damit der neue virtuelle
            # Monitor eindeutig dieser Session zugeordnet werden kann.
            if time.monotonic() >= self.retry_at and self.host.starting is None:
                self.start(best)
        elif best != self.ip:
            self.retarget(best)

    def retarget(self, ip):
        log(f"{self.name}: wechsle Verbindung {self.ip} -> {ip}")
        self.ip = ip
        if self.pipeline:
            self.pacer.ip = ip
            self.request_keyframe()
            notify(self.host.bus, self.name, "über Kabel" if is_direct_link(ip) else "über Netzwerk")

    def request_keyframe(self):
        # Der Client meldet Paketverlust oder fehlendes Bild; ohne neuen
        # Keyframe bleiben Artefakte sonst bis zum nächsten GOP stehen.
        now = time.monotonic()
        if not self.pipeline or now - self.last_keyframe < KEYFRAME_MIN_INTERVAL:
            return
        self.last_keyframe = now
        self.pipeline.get_by_name("out").send_event(
            GstVideo.video_event_new_upstream_force_key_unit(Gst.CLOCK_TIME_NONE, True, 0))

    def count_frame(self, _pad, _info):
        self.frames += 1
        return Gst.PadProbeReturn.OK

    def log_stats(self, pipeline):
        if pipeline is not self.pipeline:
            return False
        log(f"{self.name}: Statistik 5s: {self.frames} Bilder von KWin")
        self.frames = 0
        return True

    def start(self, ip):
        self.ip = ip
        self.host.starting = self
        self.outputs_before = virtual_outputs()
        self.screen = VirtualScreen(self.host.bus)
        self.screen.open(self.on_ready, self.on_error)

    def on_ready(self, fd, node_id):
        self.host.starting = None
        args = self.host.args
        self.pipeline = build_pipeline(fd, node_id, self.size, self.key, args)
        self.pacer = Pacer(self.ip)
        self.pipeline.get_by_name("out").connect("new-sample", self.pacer.on_sample)
        if self.size and not args.no_autoscale:
            for output_id in virtual_outputs() - self.outputs_before:
                set_scale(output_id, self.size[0])
        src_pad = self.pipeline.get_by_name("src").get_static_pad("src")
        src_pad.add_probe(Gst.PadProbeType.BUFFER, self.count_frame)
        src_pad.connect("notify::caps", lambda pad, _: pad.get_current_caps() and
                        log("Von KWin:", pad.get_current_caps().to_string()))
        GLib.timeout_add_seconds(5, self.log_stats, self.pipeline)
        self.pipeline.get_bus().add_signal_watch()
        self.pipeline.get_bus().connect("message::error", self.on_pipeline_error)
        self.pipeline.set_state(Gst.State.PLAYING)
        log(f"Streame virtuellen Monitor an {self.name} ({self.ip}:{proto.STREAM_PORT})")
        GLib.timeout_add_seconds(3, self.on_stable, self.pipeline)

    def on_stable(self, pipeline):
        # Erst melden, wenn der Stream ein paar Sekunden ohne Fehler läuft.
        if pipeline is self.pipeline:
            self.backoff = 0
            notify(self.host.bus, f"{self.name} verbunden",
                   "über Kabel" if is_direct_link(self.ip) else f"über Netzwerk ({self.ip})")
        return False

    def on_error(self, reason):
        self.backoff = min(self.backoff * 2 or 2, 60)
        log(f"{self.name}: Fehler: {reason} - neuer Versuch in {self.backoff}s")
        self.stop(quiet=True)
        self.retry_at = time.monotonic() + self.backoff

    def on_pipeline_error(self, _bus, msg):
        err, dbg = msg.parse_error()
        self.on_error(f"{err.message} ({dbg})")

    def stop(self, quiet=False):
        if self.host.starting is self:
            self.host.starting = None
        if self.pipeline:
            self.pipeline.set_state(Gst.State.NULL)
            self.pipeline = None
            self.pacer.close()
            if not quiet:
                notify(self.host.bus, f"{self.name} getrennt")
        if self.screen:
            self.screen.close()
            self.screen = None
        self.ip = None


class Pairing:
    """Laufende Kopplung mit einem noch unbekannten Client."""

    def __init__(self, msg, addr):
        self.id = msg["id"]
        self.name = str(msg.get("name", "?"))[:64]
        self.client_pub = msg["pub"]
        self.addr = addr
        self.host_nonce = proto.new_nonce()
        self.client_nonce = None
        self.code = None
        self.dialog = None
        self.result = None
        self.created = time.monotonic()


class Host:
    def __init__(self, args):
        self.args = args
        self.bus = dbus.SessionBus()
        self.identity = proto.Identity(KEY_FILE)
        self.name = socket.gethostname()
        self.clients = {}
        self.clients_mtime = None
        self.sessions = {}
        self.pairings = {}
        self.rejected = {}
        self.starting = None
        self.sock = None

    def run(self):
        self.sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        self.sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        self.sock.bind(("0.0.0.0", proto.BEACON_PORT))
        GLib.io_add_watch(self.sock.fileno(), GLib.IO_IN, self.on_message)
        GLib.timeout_add_seconds(1, self.check_timeout)
        log(f"Warte auf opentop-clients (UDP {proto.BEACON_PORT}) ...")
        GLib.MainLoop().run()

    def load_clients(self):
        # Neu einlesen, falls "opentop-host --forget" die Datei geändert hat.
        try:
            mtime = os.stat(CLIENTS_FILE).st_mtime
        except OSError:
            mtime = None
        if mtime != self.clients_mtime:
            self.clients_mtime = mtime
            self.clients = proto.load_json(CLIENTS_FILE, {})
            for client_id in list(self.sessions):
                if client_id not in self.clients:
                    self.sessions.pop(client_id).stop()
        return self.clients

    def send(self, msg, addr):
        try:
            self.sock.sendto(proto.encode(msg), addr)
        except OSError as e:
            log(f"Senden an {addr[0]} fehlgeschlagen:", e)

    def on_message(self, _fd, _cond):
        data, addr = self.sock.recvfrom(2048)
        msg = proto.decode(data)
        if not msg or not isinstance(msg.get("id"), str):
            return True
        handler = {"beacon": self.on_beacon, "hello": self.on_hello,
                   "nonce": self.on_nonce}.get(msg.get("type"))
        if handler:
            try:
                handler(msg, addr)
            except (KeyError, TypeError, ValueError) as e:
                log(f"Ungültige Nachricht von {addr[0]}:", e)
        return True

    def on_beacon(self, msg, addr):
        if msg.get("host") != self.identity.pub:
            return  # gehört zu einem anderen Host
        info = self.load_clients().get(msg["id"])
        if info is None:
            self.send({"type": "unknown"}, addr)
            return
        key = proto.unb64(info["key"])
        if not proto.verify(msg, key):
            return
        session = self.sessions.get(msg["id"])
        if session is None:
            session = self.sessions[msg["id"]] = Session(self, msg["id"], info)
        # Wiederholte (mitgeschnittene) Beacons verwerfen.
        if msg["seq"] <= session.last_seq:
            return
        session.last_seq = msg["seq"]
        session.on_beacon(msg, addr[0])

    def on_hello(self, msg, addr):
        info = self.load_clients().get(msg["id"])
        if info and info["pub"] == msg["pub"]:
            # Schon gekoppelt, der Client hat die Bestätigung aber verpasst.
            self.send(proto.sign({"type": "paired", "name": self.name},
                                 proto.unb64(info["key"])), addr)
            return
        if time.monotonic() < self.rejected.get(msg["id"], 0):
            return
        pairing = self.pairings.get(msg["id"])
        if pairing is None or pairing.client_pub != msg["pub"]:
            pairing = self.pairings[msg["id"]] = Pairing(msg, addr)
            log(f"Kopplungsanfrage von {pairing.name} ({addr[0]})")
        pairing.addr = addr
        self.send({"type": "commit", "pub": self.identity.pub,
                   "commit": proto.commitment(self.identity.pub, pairing.client_pub,
                                              pairing.host_nonce)}, addr)

    def on_nonce(self, msg, addr):
        pairing = self.pairings.get(msg["id"])
        if pairing is None:
            return
        pairing.addr = addr
        if pairing.client_nonce is None:
            pairing.client_nonce = msg["nonce"]
            shared = self.identity.shared(pairing.client_pub)
            pairing.code = proto.pairing_code(shared, self.identity.pub, pairing.client_pub,
                                              pairing.client_nonce, pairing.host_nonce)
            pairing.key = proto.session_key(shared, self.identity.pub, pairing.client_pub,
                                            pairing.client_nonce, pairing.host_nonce)
            self.ask_user(pairing)
        elif msg["nonce"] != pairing.client_nonce:
            return
        self.send({"type": "reveal", "nonce": pairing.host_nonce}, addr)
        if pairing.result == "paired":
            self.send(proto.sign({"type": "paired", "name": self.name}, pairing.key), addr)
        elif pairing.result == "rejected":
            self.send({"type": "rejected"}, addr)

    def ask_user(self, pairing):
        text = (f"„{pairing.name}“ möchte sich als zweiter Monitor mit diesem Rechner koppeln.\n\n"
                f"Wird auf dem Laptop dieser Code angezeigt?\n\n{pairing.code}")
        try:
            pid, *_ = GLib.spawn_async(
                ["kdialog", "--title", "opentop – Kopplung", "--yes-label", "Koppeln",
                 "--no-label", "Ablehnen", "--yesno", text],
                flags=GLib.SpawnFlags.SEARCH_PATH | GLib.SpawnFlags.DO_NOT_REAP_CHILD)
        except GLib.Error as e:
            log("Kopplungsdialog konnte nicht geöffnet werden:", e.message)
            return
        pairing.dialog = pid
        GLib.child_watch_add(GLib.PRIORITY_DEFAULT, pid, self.on_answer, pairing)

    def on_answer(self, _pid, status, pairing):
        pairing.dialog = None
        if self.pairings.get(pairing.id) is not pairing:
            return  # inzwischen abgelaufen
        if status == 0:
            pairing.result = "paired"
            clients = self.load_clients()
            clients[pairing.id] = {"name": pairing.name, "pub": pairing.client_pub,
                                   "key": proto.b64(pairing.key)}
            proto.save_json(CLIENTS_FILE, clients)
            log(f"{pairing.name} gekoppelt")
            self.send(proto.sign({"type": "paired", "name": self.name}, pairing.key), pairing.addr)
        else:
            pairing.result = "rejected"
            self.rejected[pairing.id] = time.monotonic() + REJECT_COOLDOWN
            log(f"Kopplung mit {pairing.name} abgelehnt")
            self.send({"type": "rejected"}, pairing.addr)

    def check_timeout(self):
        now = time.monotonic()
        for client_id, pairing in list(self.pairings.items()):
            if now - pairing.created > proto.PAIRING_TIMEOUT:
                if pairing.dialog:
                    os.kill(pairing.dialog, 15)
                del self.pairings[client_id]
        for session in list(self.sessions.values()):
            session.check_timeout()
        return True

    def stop(self):
        for session in self.sessions.values():
            session.stop(quiet=True)


def manage_clients(args):
    clients = proto.load_json(CLIENTS_FILE, {})
    if args.list:
        for client_id, info in clients.items():
            print(f"{info['name']}  ({client_id})")
        if not clients:
            print("Keine gekoppelten Clients.")
        return
    target = args.forget
    gone = [cid for cid, info in clients.items()
            if target in ("all", cid, info["name"])]
    for cid in gone:
        print(f"Entkoppelt: {clients.pop(cid)['name']}")
    if not gone:
        print(f"Kein gekoppelter Client „{target}“.")
    proto.save_json(CLIENTS_FILE, clients)


def main():
    p = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    p.add_argument("--bitrate", type=int, default=10000, help="kbit/s (Standard: 10000)")
    p.add_argument("--fps", type=int, default=60)
    p.add_argument("--software", action="store_true", help="x264 statt VA-API verwenden")
    p.add_argument("--list", action="store_true", help="gekoppelte Clients anzeigen")
    p.add_argument("--forget", metavar="NAME|ID|all", help="Kopplung mit einem Client aufheben")
    p.add_argument("--no-autoscale", action="store_true",
                   help="Skalierung des virtuellen Monitors nicht anpassen")
    args = p.parse_args()
    if args.list or args.forget:
        return manage_clients(args)

    DBusGMainLoop(set_as_default=True)
    Gst.init(None)
    host = Host(args)
    try:
        host.run()
    except KeyboardInterrupt:
        pass
    finally:
        host.stop()


if __name__ == "__main__":
    sys.exit(main())
