#!/usr/bin/env python3
"""opentop-host: legt virtuelle Monitore an und streamt sie verschlüsselt per
H.264/SRTP an gekoppelte opentop-clients im LAN.

Wählt das Backend passend zum Betriebssystem: KDE Plasma unter Linux,
Virtual Display Driver unter Windows. Die eigentliche Logik liegt in
opentop_host.py.
"""
import os
import sys

sys.path[:0] = [os.path.dirname(os.path.realpath(__file__)),
                os.path.expanduser("~/.local/share/opentop")]

import opentop_host

if sys.platform == "win32":
    from opentop_windows import WindowsBackend as Backend
else:
    from opentop_kde import KdeBackend as Backend

if __name__ == "__main__":
    sys.exit(opentop_host.main(Backend()))
